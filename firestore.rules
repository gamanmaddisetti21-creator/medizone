rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{uid} {
      function signedIn() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validCustomerData() {
        return request.resource.data.keys().hasOnly([
          'uid', 'name', 'phoneNumber', 'email', 'addresses', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.addresses is list
        && request.resource.data.addresses.size() <= 10
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validCustomerData();
      allow update: if signedIn()
                    && resource.data.uid == uid
                    && validCustomerData()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.phoneNumber == resource.data.phoneNumber
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
  }
}
